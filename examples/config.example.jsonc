{
  "server": {
    "port": 24046,
    "bind_localhost": true,
    "bind_lan_ip": null,
    "token": null,
    "max_body_bytes": 65536
  },
  "qq": {
    "target_open_id": null
  },
  "queue": {
    "max_attempts": 3,
    "backoff_ms": [2000, 8000, 30000],
    "cooldown_ms": 300000,
    "cooldown_max_ms": 3600000,
    "halt_after_abandons": 5,
    "max_outbox": 1000,
    "send_rate_per_second": 1,
    "history_keep": 1000
  },
  "log": {
    "level": "info",
    "dir": null,
    "max_size_bytes": 10485760,
    "max_files": 5,
    "console": true
  },
  "storage": {
    "data_dir": "./data"
  }
}
